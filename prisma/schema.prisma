// Backing store for the interactive product demo at /product-demo.
// Real accounts: a coach signs up directly; a client only ever gets in via
// an invite link a coach generates, so every Client row always has a home.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  coach
  client
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             Role
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  twoFactorCodes   TwoFactorCode[]

  // Present only for role = coach
  coachedClients Client[]  @relation("CoachToClients")
  programs       Program[]

  // Present only for role = client
  clientProfile Client? @relation("UserToClient")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TwoFactorCode {
  id        String    @id @default(cuid())
  code      String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Program {
  id        String   @id
  name      String
  days      Json
  coachId   String
  createdAt DateTime @default(now())

  coach   User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clients Client[]

  @@index([coachId])
}

model Client {
  id          String   @id @default(cuid())
  name        String
  initials    String
  coachId     String
  userId      String?  @unique
  programId   String?
  adherence   Int      @default(0)
  status      String   @default("New")
  nextCheckIn String   @default("—")
  weightUnit  String   @default("lb")
  weightLog   Json     @default("[]")
  workoutLogs Json     @default("[]")
  messages    Json     @default("[]")
  createdAt   DateTime @default(now())

  coach   User     @relation("CoachToClients", fields: [coachId], references: [id], onDelete: Cascade)
  user    User?    @relation("UserToClient", fields: [userId], references: [id], onDelete: SetNull)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  invite  Invite?

  @@index([coachId])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  clientId  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
